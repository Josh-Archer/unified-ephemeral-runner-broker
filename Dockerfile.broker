# Build on the builder's native arch (BUILDPLATFORM) and cross-compile with
# GOARCH=TARGETARCH. Without --platform=$BUILDPLATFORM, multi-arch builds run
# the Go toolchain under QEMU for arm64 and can take hours.
FROM --platform=$BUILDPLATFORM golang:1.24.1 AS build
WORKDIR /src

COPY go.mod go.sum* ./
RUN go mod download

COPY . .
# TARGETARCH / TARGETOS are set by Buildx for multi-platform builds.
ARG TARGETOS=linux
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o /out/broker ./cmd/broker

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /
COPY --from=build /out/broker /broker
ENTRYPOINT ["/broker"]

