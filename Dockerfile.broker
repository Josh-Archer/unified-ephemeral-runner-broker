FROM golang:1.24.1 AS build
WORKDIR /src

COPY go.mod go.sum* ./
RUN go mod download

COPY . .
# TARGETARCH is set by Buildx for multi-platform builds (amd64, arm64).
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -o /out/broker ./cmd/broker

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /
COPY --from=build /out/broker /broker
ENTRYPOINT ["/broker"]

