{
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, pool) (rate(uecb_allocation_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{pool}}"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, pool) (rate(uecb_allocation_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{pool}}"
        }
      ],
      "title": "Allocation Latency",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, pool, backend, launch_mode) (rate(uecb_launch_latency_seconds_bucket[5m])))",
          "legendFormat": "launch p95 {{pool}}/{{backend}} {{launch_mode}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, pool, backend) (rate(uecb_registration_latency_seconds_bucket[5m])))",
          "legendFormat": "registration p95 {{pool}}/{{backend}}"
        }
      ],
      "title": "Launch and Registration Latency",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (pool, backend, result) (rate(uecb_allocations_total[5m]))",
          "legendFormat": "{{pool}}/{{backend}} {{result}}"
        }
      ],
      "title": "Allocation Rate",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (pool, state) (uecb_queue_depth)",
          "legendFormat": "{{pool}} {{state}}"
        }
      ],
      "title": "Queue Depth",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "id": 5,
      "targets": [
        {
          "expr": "uecb_capacity_utilization_ratio",
          "legendFormat": "{{pool}}/{{backend}}"
        }
      ],
      "title": "Capacity Utilization",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (pool, backend, action) (rate(uecb_orphan_cleanup_actions_total[5m]))",
          "legendFormat": "orphan {{pool}}/{{backend}} {{action}}"
        },
        {
          "expr": "sum by (pool, backend, result) (rate(uecb_label_garbage_total[5m]))",
          "legendFormat": "label gc {{pool}}/{{backend}} {{result}}"
        }
      ],
      "title": "Orphan Cleanup and Label Garbage",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (pool, backend, phase) (uecb_stale_runner_labels)",
          "legendFormat": "{{pool}}/{{backend}} {{phase}}"
        }
      ],
      "title": "Stale Runner Labels",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "p95 end-to-end latency of successful allocations, grouped by pool and backend. SLO example is 60 seconds.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 8,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, pool, backend) (rate(uecb_allocation_latency_seconds_bucket{result=\"success\"}[5m])))",
          "legendFormat": "p95 {{pool}}/{{backend}}"
        }
      ],
      "title": "Allocation Latency by Backend",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Share of allocation attempts with result=failure, by pool and backend. Queued attempts are not failures. SLO example is 5 percent.",
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 9,
      "targets": [
        {
          "expr": "sum by (pool, backend) (rate(uecb_allocations_total{result=\"failure\"}[5m])) / clamp_min(sum by (pool, backend) (rate(uecb_allocations_total[5m])), 0.001)",
          "legendFormat": "{{pool}}/{{backend}}"
        }
      ],
      "title": "Allocation Failure Ratio by Backend",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Per-second estimated cost of successful allocations. Uses estimatedCostPerAllocation when set; otherwise the effective cost class. Not a cloud bill.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "id": 10,
      "targets": [
        {
          "expr": "sum by (pool, backend) (rate(uecb_backend_estimated_cost_total[5m]))",
          "legendFormat": "{{pool}}/{{backend}}"
        }
      ],
      "title": "Estimated Cost Rate",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Cumulative estimated cost of successful allocations since process start.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "id": 11,
      "targets": [
        {
          "expr": "sum by (pool, backend) (uecb_backend_estimated_cost_total)",
          "legendFormat": "{{pool}}/{{backend}}"
        }
      ],
      "title": "Estimated Cost Total",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Effective scheduler cost class. Lower is cheaper.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "id": 12,
      "targets": [
        {
          "expr": "uecb_backend_cost_class",
          "legendFormat": "{{pool}}/{{backend}}"
        }
      ],
      "title": "Backend Cost Class",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Cost added for one successful allocation on this backend.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "id": 13,
      "targets": [
        {
          "expr": "uecb_backend_estimated_unit_cost",
          "legendFormat": "{{pool}}/{{backend}}"
        }
      ],
      "title": "Estimated Unit Cost",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "uecb",
    "github-actions",
    "ephemeral-runners"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "label": "Prometheus",
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "description": "Per-backend allocation latency, failure ratio, and estimated cost for the unified ephemeral runner broker.",
  "title": "Unified Ephemeral Runner Broker",
  "uid": "uecb-observability-pack",
  "version": 2
}
